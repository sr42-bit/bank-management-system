# Copy to .env and replace every placeholder. Never commit .env.
MYSQL_ROOT_PASSWORD=REPLACE_WITH_UNIQUE_ROOT_PASSWORD
DB_USERNAME=bankuser
DB_PASSWORD=REPLACE_WITH_UNIQUE_DATABASE_PASSWORD
JWT_SECRET=REPLACE_WITH_RANDOM_SECRET_AT_LEAST_32_BYTES

# Optional initial admin provisioning: set once, start the app, then remove these values.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
